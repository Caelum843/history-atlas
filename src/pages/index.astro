---
import Shell from '../layouts/Shell.astro';
import ObjectDrawer from '../components/ObjectDrawer.astro';
import { getCollection } from 'astro:content';
import { sitePath } from '../lib/paths';

const VB={width:1600,height:900};
const world=await getCollection('world');
const regions=world.filter(n=>n.data.type==='region');
const stops=[
 {year:-753,short:'前 753',label:'城市形成与王政传统',note:'传统建城纪年只是导航坐标，早期历史大量依赖后世叙述与考古。',reach:.02,unity:1,west:0,east:0},
 {year:-509,short:'前 509',label:'共和国与意大利共同体',note:'共和国制度与罗马在意大利的扩张共同形成。',reach:.08,unity:1,west:0,east:0},
 {year:-264,short:'前 264',label:'地中海争霸开始',note:'控制意大利以后，罗马开始卷入跨海霸权战争。',reach:.24,unity:1,west:0,east:0},
 {year:-133,short:'前 133',label:'共和国危机',note:'帝国扩张积累的问题进入公民政治，当前实验样卷从这里开放。',reach:.48,unity:1,west:0,east:0},
 {year:-49,short:'前 49',label:'卢比孔与内战',note:'政治冲突取得军事既成事实；地图状态综合使用前 50—前 49 年资料。',reach:.56,unity:1,west:0,east:0},
 {year:-27,short:'前 27',label:'元首制建立',note:'新的君主权力以恢复共和国的语言建立。',reach:.62,unity:1,west:0,east:0},
 {year:117,short:'117',label:'高帝国',note:'帝国达到最大空间范围附近；当前范围仅作体验示意。',reach:.92,unity:1,west:0,east:0},
 {year:284,short:'284',label:'晚期帝国的再造',note:'行政、军队、税制与皇帝宫廷被重新组织。',reach:.82,unity:.78,west:.16,east:.18},
 {year:395,short:'395',label:'两个皇帝宫廷',note:'东西各有宫廷，但双方仍宣称属于同一个罗马帝国。',reach:.72,unity:.2,west:.62,east:.68},
 {year:476,short:'476',label:'西部皇帝终结',note:'这不是罗马历史终点；东部罗马帝国继续延伸。',reach:.62,unity:0,west:.05,east:.72},
];
const min=stops[0].year,max=stops.at(-1)!.year,pos=(y:number)=>(y-min)/(max-min)*100;
---
<Shell layer="world" title="History Atlas · 历史世界" context="历史世界 · 时间地图">
<div class="world" id="timeMap" data-mode="terrain" style="--p:57.28%;--state-y:57.1vh;--reach:.56;--unity:1;--west:0;--east:0">
 <svg class="map" viewBox={`0 0 ${VB.width} ${VB.height}`} preserveAspectRatio="xMidYMid slice" role="img" aria-label="随时间变化的历史世界">
  <defs><radialGradient id="field"><stop stop-color="#c9a15b" stop-opacity=".42"/><stop offset="1" stop-color="#9a7133" stop-opacity="0"/></radialGradient><radialGradient id="fieldEast"><stop stop-color="#8fb6cf" stop-opacity=".38"/><stop offset="1" stop-color="#617f92" stop-opacity="0"/></radialGradient><filter id="soft"><feGaussianBlur stdDeviation="12"/></filter></defs>
  <path id="spherePath" class="sphere"/><path id="graticulePath" class="graticule"/><path id="landPath" class="land"/>
  <g class="polity"><ellipse id="fieldUnified" class="unified" rx="355" ry="205" fill="url(#field)" filter="url(#soft)"/><ellipse id="fieldWest" class="west" rx="245" ry="180" fill="url(#field)" filter="url(#soft)"/><ellipse id="fieldEast" class="east" rx="250" ry="185" fill="url(#fieldEast)" filter="url(#soft)"/><circle id="fieldOrigin" r="7"/></g>
 </svg>
 <div class="nodes">{regions.map(node=>node.data.planned?<button class="node planned" data-lon={node.data.lon} data-lat={node.data.lat} data-object={node.id}><i></i><strong>{node.data.title.zh}</strong><span>规划中</span></button>:<a class="node open" data-lon={node.data.lon} data-lat={node.data.lat} href={sitePath(node.data.entry!)}><i></i><strong>{node.data.title.zh}</strong><span id="romeMeta">前 49 年 · 共和国危机可进入</span></a>)}</div>
 <header class="intro"><p>一部可以进入的历史书</p><h1>拖动时间，<br/>观察世界改变。</h1><div id="description">政治冲突取得军事既成事实；地图状态综合使用前 50—前 49 年资料。</div><span id="accuracy">地形模式 · 海陆轮廓为现代测绘参照</span></header>
 <section class="clock" id="clock" aria-label="历史时间与地图模式"><small>约前 753</small><div class="track" id="track" role="slider" tabindex="0" aria-label="历史年份" aria-valuemin={min} aria-valuemax={max} aria-valuenow="-49">{stops.map(s=><button class:list={['stop',{major:[-753,-133,-49,-27,395,476].includes(s.year)}]} style={`top:${pos(s.year)}%`} data-year={s.year}><i></i><span>{s.short}</span></button>)}<div class="probe" id="probe"><i></i><span id="probeYear"></span></div><div class="thumb"><span class="mode terrain-mode"><button data-mode="terrain" aria-pressed="true">地形</button><i></i></span><strong id="year">前 49</strong><span class="mode polity-mode"><i></i><button data-mode="polity" aria-pressed="false">政权</button></span></div></div><small>公元 476</small></section>
 <div class="state"><span id="stateYear">前 49 年</span><strong id="stateTitle">卢比孔与内战</strong><em>靠近关键年份时自动吸附</em></div>
</div>
<ObjectDrawer slot="overlay"/><script type="application/json" id="timeData" set:html={JSON.stringify(stops)} is:inline slot="overlay"></script>
</Shell>
<script>
import { geoDistance, geoGraticule10, geoOrthographic, geoPath } from 'd3-geo';
import { feature } from 'topojson-client';
import land110 from 'world-atlas/land-110m.json';
type Stop={year:number;short:string;label:string;note:string;reach:number;unity:number;west:number;east:number};
const root=document.getElementById('timeMap')!,track=document.getElementById('track')!,clock=document.getElementById('clock')!,data:Stop[]=JSON.parse(document.getElementById('timeData')!.textContent!);const min=data[0].year,max=data.at(-1)!.year;let target=-49,current=-49,drag=false,wheelTimer=0;
const clamp=(v:number,a:number,b:number)=>Math.max(a,Math.min(b,v)),fmt=(y:number)=>y<0?`前 ${Math.abs(Math.round(y))}`:`公元 ${Math.round(y)}`;

const svg=document.querySelector<SVGSVGElement>('.map')!;
const topology=land110 as any, landFeature=feature(topology,topology.objects.land) as any;
const projection=geoOrthographic().translate([800,450]).scale(415).clipAngle(90).precision(.35).rotate([-18,-25,0]);
const path=geoPath(projection), sphere={type:'Sphere'} as any;
const landPath=document.getElementById('landPath')!,spherePath=document.getElementById('spherePath')!,graticulePath=document.getElementById('graticulePath')!;
const geoNodes=[...document.querySelectorAll<HTMLElement>('.node[data-lon]')];
const fields=[{el:document.getElementById('fieldUnified')!,at:[14.5,40]},{el:document.getElementById('fieldWest')!,at:[1,40]},{el:document.getElementById('fieldEast')!,at:[28,38]},{el:document.getElementById('fieldOrigin')!,at:[14.5,40]}] as {el:SVGElement;at:[number,number]}[];
function visible(at:[number,number]){const r=projection.rotate();return geoDistance(at,[-r[0],-r[1]])<Math.PI/2-.24}
function renderGlobe(){spherePath.setAttribute('d',path(sphere)??'');landPath.setAttribute('d',path(landFeature)??'');graticulePath.setAttribute('d',path(geoGraticule10())??'');geoNodes.forEach(node=>{const at:[number,number]=[Number(node.dataset.lon),Number(node.dataset.lat)],p=projection(at);if(!p||!visible(at)){node.style.opacity='0';node.style.pointerEvents='none'}else{node.style.left=`${p[0]/16}%`;node.style.top=`${p[1]/9}%`;node.style.opacity='';node.style.pointerEvents=''}});fields.forEach(({el,at})=>{const p=projection(at);if(p){el.setAttribute('cx',String(p[0]));el.setAttribute('cy',String(p[1]))}el.style.visibility=visible(at)?'visible':'hidden'})}
renderGlobe();
let globeDrag=false,lastX=0,lastY=0,vx=0,vy=0,inertia=0;
root.addEventListener('pointerdown',e=>{if((e.target as HTMLElement).closest('.clock,.node,.intro,a,button'))return;globeDrag=true;lastX=e.clientX;lastY=e.clientY;vx=vy=0;cancelAnimationFrame(inertia);root.setPointerCapture(e.pointerId);root.dataset.globeDrag='true';e.preventDefault()});
root.addEventListener('pointermove',e=>{if(!globeDrag)return;const dx=e.clientX-lastX,dy=e.clientY-lastY,r=projection.rotate();vx=dx*.22;vy=-dy*.18;projection.rotate([r[0]+vx,clamp(r[1]+vy,-72,72),0]);lastX=e.clientX;lastY=e.clientY;renderGlobe()});
function coast(){if(Math.abs(vx)+Math.abs(vy)<.04)return;const r=projection.rotate();projection.rotate([r[0]+vx,r[1]+vy,0]);vx*=.91;vy*=.91;renderGlobe();inertia=requestAnimationFrame(coast)}
root.addEventListener('pointerup',()=>{if(!globeDrag)return;globeDrag=false;delete root.dataset.globeDrag;coast()});
function pair(y:number){let i=data.findIndex(s=>s.year>=y);if(i<=0)return[data[0],data[0],0] as const;if(i<0)return[data.at(-1)!,data.at(-1)!,0] as const;let a=data[i-1],b=data[i];return[a,b,(y-a.year)/(b.year-a.year)] as const}const mix=(a:number,b:number,t:number)=>a+(b-a)*t;
function render(y:number){const[a,b,t]=pair(y),near=t<.5?a:b,fy=fmt(y),p=(y-min)/(max-min)*100;root.style.setProperty('--p',`${p}%`);root.style.setProperty('--state-y',`${13+p*.77}vh`);for(const k of ['reach','unity','west','east'] as const)root.style.setProperty(`--${k}`,String(mix(a[k],b[k],t)));document.getElementById('year')!.textContent=fy.replace('公元 ','');document.getElementById('stateYear')!.textContent=`${fy} 年`;document.getElementById('stateTitle')!.textContent=near.label;document.getElementById('description')!.textContent=near.note;document.getElementById('romeMeta')!.textContent=y>=-133&&y<=-27?`${fy} · 共和国危机可进入`:`${fy} · 进入罗马时间主干`;track.setAttribute('aria-valuenow',String(Math.round(y)))}
function loop(){const d=target-current;current=Math.abs(d)<.08?target:current+d*.18;render(current);requestAnimationFrame(loop)}loop();
const fromPointer=(e:PointerEvent)=>Math.round(min+clamp((e.clientY-track.getBoundingClientRect().top)/track.getBoundingClientRect().height,0,1)*(max-min));const snap=(y:number)=>{const s=data.reduce((a,b)=>Math.abs(b.year-y)<Math.abs(a.year-y)?b:a);return Math.abs(s.year-y)<=34?s.year:y};
const probe=document.getElementById('probe')!,probeYear=document.getElementById('probeYear')!;
track.addEventListener('pointerdown',e=>{if((e.target as HTMLElement).closest('button'))return;drag=true;track.setPointerCapture(e.pointerId);target=fromPointer(e);probe.classList.add('active');e.preventDefault()});track.addEventListener('pointermove',e=>{const rect=track.getBoundingClientRect(),p=clamp((e.clientY-rect.top)/rect.height,0,1);probe.style.top=`${p*100}%`;probeYear.textContent=fmt(min+p*(max-min));probe.classList.add('visible');if(drag)target=fromPointer(e)});track.addEventListener('pointerleave',()=>{if(!drag)probe.classList.remove('visible')});track.addEventListener('pointerup',e=>{if(!drag)return;drag=false;target=snap(fromPointer(e));probe.classList.remove('active','visible')});
clock.addEventListener('wheel',e=>{e.preventDefault();target=clamp(target+(e.deltaY>0?10:-10),min,max);window.clearTimeout(wheelTimer);wheelTimer=window.setTimeout(()=>target=snap(target),180)},{passive:false});
track.addEventListener('keydown',e=>{const n:{[k:string]:number}={ArrowUp:-10,ArrowDown:10,PageUp:-50,PageDown:50};if(e.key==='Home')target=min;else if(e.key==='End')target=max;else if(n[e.key])target=clamp(target+n[e.key],min,max);else return;e.preventDefault()});document.querySelectorAll<HTMLElement>('[data-year]').forEach(b=>b.addEventListener('click',()=>target=Number(b.dataset.year)));document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach(b=>b.addEventListener('click',()=>{root.dataset.mode=b.dataset.mode!;document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));document.getElementById('accuracy')!.textContent=b.dataset.mode==='terrain'?'地形模式 · 海陆轮廓为现代测绘参照':'政权模式 · 范围为编辑示意，不代表逐年精确边界'}));
</script>
<style>
.world{position:absolute;inset:0;overflow:hidden}.map{position:absolute;width:100%;height:100%}.sea{fill:#070b0f}.land{fill:var(--l-land);stroke:var(--l-land-edge);stroke-width:.8;transition:.7s}.terrain{opacity:.4;transition:.7s}.terrain path{fill:none;stroke:#6d8998;stroke-width:.6;stroke-dasharray:2 12;opacity:.3}.polity{opacity:0;transition:.7s}.polity ellipse{transform-box:fill-box;transform-origin:center}.unified{opacity:var(--unity);transform:scale(calc(.12 + var(--reach)*.88))}.west{opacity:var(--west);transform:scale(calc(.2 + var(--reach)*.8))}.east{opacity:var(--east);transform:scale(calc(.2 + var(--reach)*.8))}.polity circle{fill:var(--l-warm)}[data-mode=polity] .polity{opacity:1}[data-mode=polity] .terrain{opacity:.04}[data-mode=polity] .land{fill:#101719;stroke:#2b3d43}
.nodes{position:absolute;inset:0}.node{position:absolute;transform:translate(-6px,-50%);display:grid;grid-template-columns:auto 1fr;gap:.2rem .6rem;background:none;border:0;text-align:left;text-decoration:none;font-family:var(--l-font-body);cursor:pointer}.node i{grid-row:1;width:6px;height:6px;border-radius:50%;background:var(--l-ink-faint)}.node strong{color:var(--l-ink-dim);font-weight:300}.node span{grid-column:2;color:var(--l-ink-faint);font:.5rem var(--l-font-mono)}.open i{width:9px;height:9px;background:var(--l-warm);box-shadow:0 0 18px var(--l-warm)}.open strong{color:var(--l-ink);font-size:1.25rem}.open span{color:var(--l-warm)}.planned{opacity:.45}
.intro{position:absolute;left:5vw;top:20vh;width:min(25rem,34vw)}.intro>p{color:var(--l-accent);font:.58rem var(--l-font-mono);letter-spacing:.2em}.intro h1{margin:1rem 0;color:var(--l-ink);font:300 clamp(2.5rem,4.2vw,4.2rem)/1.05 var(--l-font-display)}.intro div{color:var(--l-ink-dim);font-size:.82rem;line-height:1.9}.intro>span{display:block;margin-top:1rem;padding-left:.8rem;border-left:1px solid var(--l-cool);color:var(--l-ink-faint);font:.5rem var(--l-font-mono)}
.clock{position:absolute;z-index:10;left:68%;top:13vh;bottom:10vh;width:4rem;display:grid;grid-template-rows:auto 1fr auto;gap:.6rem;text-align:center}.clock small{color:var(--l-ink-faint);font:.46rem var(--l-font-mono)}.track{position:relative;width:1px;margin:auto;background:linear-gradient(var(--l-rule),var(--l-cool),var(--l-rule));cursor:ns-resize;touch-action:none}.stop{position:absolute;left:-4px;width:9px;height:1px;padding:0;border:0;background:var(--l-rule);cursor:pointer}.stop span{position:absolute;left:1rem;top:-.35rem;color:transparent;white-space:nowrap;font:.44rem var(--l-font-mono)}.stop.major span,.stop:hover span{color:var(--l-ink-faint)}.thumb{position:absolute;top:var(--p);transition:top .08s}.thumb:before{content:'';position:absolute;left:-7px;top:-7px;width:13px;height:13px;border:1px solid var(--l-accent);border-radius:50%;background:var(--l-ground)}.thumb>strong{position:absolute;right:1rem;top:-.7rem;color:var(--l-ink);white-space:nowrap;font:1rem var(--l-font-display)}.mode{position:absolute;top:-.55rem;display:flex;align-items:center}.mode i{width:1.3rem;height:1px;background:var(--l-rule)}.terrain-mode{right:4.2rem}.polity-mode{left:1rem}.mode button{padding:.32rem .48rem;border:1px solid transparent;background:rgba(7,11,15,.8);color:var(--l-ink-faint);font:.48rem var(--l-font-mono);cursor:pointer}.mode button[aria-pressed=true]{border-color:var(--l-accent-dim);color:var(--l-accent)}
.state{position:absolute;left:72%;top:var(--state-y);transform:translateY(-50%);display:grid;gap:.3rem;width:20vw}.state span,.state em{color:var(--l-ink-faint);font:.48rem var(--l-font-mono);font-style:normal}.state strong{color:var(--l-ink);font:300 1.15rem var(--l-font-body)}
.track{height:100%;margin:0 auto}.stop{height:16px;transform:translateY(-8px);background:none}.stop i{position:absolute;left:0;top:8px;width:9px;height:1px;background:var(--l-rule)}.stop span{top:4px}
/* M2.2：可拨动球面与独立但相连的时间仪器 */
.world{user-select:none;-webkit-user-select:none}.map{cursor:grab;touch-action:none}.world[data-globe-drag=true] .map{cursor:grabbing}.sphere{fill:#071015;stroke:#31434b;stroke-width:1}.land{fill:#142027;stroke:#344a55;stroke-width:.85}.graticule{fill:none;stroke:#36505c;stroke-width:.45;stroke-opacity:.24;transition:opacity .6s}[data-mode=polity] .graticule{opacity:.08}
.node strong{font-size:.92rem;text-shadow:0 2px 8px #05090b}.node span{font-size:.68rem;line-height:1.4;letter-spacing:.06em;text-shadow:0 2px 8px #05090b}.open strong{font-size:1.35rem}.planned{opacity:.58}
.intro>p{font-size:.68rem}.intro div{font-size:.94rem;line-height:1.85}.intro>span{font-size:.68rem;line-height:1.6;color:#82949d}
.clock{left:auto;right:6vw;top:10vh;bottom:7vh;width:7rem;padding:1.1rem 1.65rem;border:1px solid rgba(143,182,207,.2);border-radius:2px;background:linear-gradient(90deg,rgba(5,10,13,.58),rgba(13,23,28,.84) 45%,rgba(5,10,13,.58));box-shadow:0 18px 65px rgba(0,0,0,.34),inset 0 0 32px rgba(143,182,207,.025);backdrop-filter:blur(9px);-webkit-backdrop-filter:blur(9px);cursor:default}.clock:before{content:'TIME';position:absolute;top:.65rem;left:.65rem;color:#718691;font:.58rem var(--l-font-mono);letter-spacing:.18em}.clock small{font-size:.66rem;color:#93a3ad}.track{width:2px;background:linear-gradient(#3d5360,#9bb6c3 48%,#3d5360);cursor:default}.stop{left:-6px;width:14px}.stop i{width:14px;background:#526975}.stop span{left:1.35rem;top:2px;color:#82949d;font-size:.62rem}.stop.major span{color:#a8b5ba}.thumb:before{left:-8px;top:-8px;width:15px;height:15px;border:2px solid var(--l-accent);box-shadow:0 0 0 7px rgba(201,161,91,.08),0 0 20px rgba(201,161,91,.25)}.thumb>strong{right:1.45rem;top:-.8rem;font-size:1.25rem}.mode button{font-size:.64rem;padding:.4rem .55rem;background:rgba(7,13,16,.94)}.terrain-mode{right:5.25rem}.polity-mode{left:1.4rem}.mode i{width:1.7rem}
.state{left:auto;right:17rem;width:15rem;padding:.85rem 1rem;border-right:1px solid rgba(143,182,207,.32);text-align:right;background:linear-gradient(90deg,transparent,rgba(5,10,13,.64))}.state span,.state em{font-size:.64rem;line-height:1.5}.state strong{font-size:1.32rem}.state em{color:#788990}
.probe{position:absolute;left:0;top:0;opacity:0;pointer-events:none;transition:opacity .15s}.probe.visible{opacity:1}.probe i{position:absolute;left:-8px;top:-8px;width:15px;height:15px;border:1px solid #8fb6cf;border-radius:50%;background:rgba(7,13,16,.85)}.probe span{position:absolute;left:1.4rem;top:-.55rem;padding:.2rem .35rem;background:rgba(7,13,16,.9);color:#b9c8cf;white-space:nowrap;font:.64rem var(--l-font-mono)}.probe.active i{border-color:var(--l-accent);box-shadow:0 0 0 6px rgba(201,161,91,.09)}.probe.active span{color:var(--l-accent)}
.drawer,.evidence{user-select:text;-webkit-user-select:text}
@media(max-width:860px){.intro{left:1rem;top:5rem;width:60vw}.intro h1{font-size:2.3rem}.clock{left:auto;right:2rem;top:20vh;bottom:14vh}.state{left:auto;right:5rem;width:9rem;text-align:right}.planned{display:none}}
</style>
