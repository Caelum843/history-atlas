---
import Shell from '../layouts/Shell.astro';
import ObjectDrawer from '../components/ObjectDrawer.astro';
import { worldEpochs } from '../lib/worldTimeline';

const minYear = worldEpochs[0].year;
const maxYear = worldEpochs.at(-1)!.year;
const yearPosition = (year: number) => (year - minYear) / (maxYear - minYear) * 100;
const majorYears = new Set([-753, -509, -264, -133, -49, -27, 117, 395, 476]);
---

<Shell layer="world" title="History Atlas · 历史世界" context="历史世界 · 时间观测台">
  <div class="world" id="historyWorld" style="--time-p:57.28%;">
    <svg class="world-map" id="worldMap" role="img" aria-label="可旋转、缩放并随年代变化的历史世界地图">
      <defs>
        <radialGradient id="oceanGlow" cx="48%" cy="42%" r="68%">
          <stop offset="0" stop-color="#1d2925" /><stop offset=".65" stop-color="#111916" /><stop offset="1" stop-color="#080b0a" />
        </radialGradient>
        <linearGradient id="landWash" x1="0" y1="0" x2="1" y2="1">
          <stop stop-color="#354038" /><stop offset=".48" stop-color="#252e29" /><stop offset="1" stop-color="#1c2420" />
        </linearGradient>
        <filter id="terrainTexture" x="-20%" y="-20%" width="140%" height="140%">
          <feTurbulence type="fractalNoise" baseFrequency=".72" numOctaves="2" seed="8" result="noise" />
          <feColorMatrix in="noise" type="saturate" values="0" result="gray" />
          <feComponentTransfer in="gray" result="softNoise"><feFuncA type="table" tableValues="0 .13" /></feComponentTransfer>
          <feBlend in="SourceGraphic" in2="softNoise" mode="soft-light" />
        </filter>
        <filter id="fieldSoft" x="-35%" y="-35%" width="170%" height="170%"><feGaussianBlur stdDeviation="5" /></filter>
        <filter id="mapShadow" x="-25%" y="-25%" width="150%" height="150%"><feDropShadow dx="0" dy="20" stdDeviation="28" flood-color="#000" flood-opacity=".48" /></filter>
        <clipPath id="sphereClip"><path id="sphereClipPath" /></clipPath>
      </defs>
      <path id="spherePath" class="sphere" filter="url(#mapShadow)" />
      <g clip-path="url(#sphereClip)">
        <path id="landPath" class="land" filter="url(#terrainTexture)" />
        <path id="graticulePath" class="graticule" />
        <g id="terrainFeatures" class="terrain-features"></g>
        <g id="historicalFieldsA" class="historical-fields"></g>
        <g id="historicalFieldsB" class="historical-fields"></g>
      </g>
    </svg>

    <div id="eraLabels" class="era-labels" aria-live="polite"></div>
    <div id="placeLabels" class="place-labels"></div>

    <header class="intro">
      <p>THE WORLD AT A MOMENT</p>
      <h1>移动时间，<br />观察历史世界。</h1>
      <div>转动球面寻找地区；靠近地图，让河流、城市与事件逐层浮现。</div>
    </header>

    <section class="epoch-heading" aria-live="polite">
      <span id="epochYear">公元前 49 年</span><strong id="epochTitle">旧秩序的断裂</strong>
    </section>

    <section class="time-instrument" id="timeInstrument" aria-label="历史时间仪">
      <div class="instrument-heading"><span>TIME</span><strong id="instrumentYear">前 49</strong></div>
      <div class="time-rail" id="timeRail" role="slider" tabindex="0" aria-label="历史年份" aria-valuemin={minYear} aria-valuemax={maxYear} aria-valuenow="-49">
        <i class="rail-line" aria-hidden="true"></i>
        {worldEpochs.map((epoch) => (
          <button class:list={['time-stop', { major: majorYears.has(epoch.year) }]} style={`top:${yearPosition(epoch.year)}%`} data-year={epoch.year} aria-label={`${epoch.short}年，${epoch.title}`}>
            <i></i><span>{epoch.short}</span>
          </button>
        ))}
        <div class="time-thumb" id="timeThumb"><i></i><span id="thumbYear">前 49</span></div>
      </div>
      <div class="instrument-ends"><span>前 753</span><span>476</span></div>
    </section>

    <nav class="map-controls" aria-label="地图视角控制">
      <button id="zoomIn" aria-label="放大地图">＋</button><button id="zoomOut" aria-label="缩小地图">−</button><button id="resetView" class="reset-view" aria-label="返回初始观察位置">◎</button>
    </nav>
    <div class="map-status"><span id="scaleState">世界尺度</span><i></i><span id="detailState">文明与政权</span></div>
    <p class="interaction-hint"><span>拖动</span> 转动世界　 <span>滚轮</span> 靠近地图　 <span>时间仪</span> 改变年代</p>
    <div class="vignette" aria-hidden="true"></div>
  </div>
  <ObjectDrawer slot="overlay" />
</Shell>

<script>
  import { geoDistance, geoGraticule10, geoOrthographic, geoPath } from 'd3-geo';
  import { feature } from 'topojson-client';
  import land110 from 'world-atlas/land-110m.json';
  import { physicalFeatures, placeLabels, worldEpochs } from '../lib/worldTimeline';

  type Coordinates = [number, number];
  const root = document.getElementById('historyWorld')!;
  const svg = document.getElementById('worldMap') as unknown as SVGSVGElement;
  const spherePath = document.getElementById('spherePath')!;
  const sphereClipPath = document.getElementById('sphereClipPath')!;
  const landPath = document.getElementById('landPath')!;
  const graticulePath = document.getElementById('graticulePath')!;
  const terrainLayer = document.getElementById('terrainFeatures')!;
  const fieldLayerA = document.getElementById('historicalFieldsA')!;
  const fieldLayerB = document.getElementById('historicalFieldsB')!;
  const eraLabels = document.getElementById('eraLabels')!;
  const placeLabelsLayer = document.getElementById('placeLabels')!;
  const rail = document.getElementById('timeRail')!;
  const topologyFeature = (source: any) => feature(source, source.objects.land) as any;
  const worldLand = topologyFeature(land110 as any);
  let regionLand: any = null;
  let localLand: any = null;
  let regionLandLoading = false, localLandLoading = false;

  const minYear = worldEpochs[0].year;
  const maxYear = worldEpochs.at(-1)!.year;
  const initialRotation: [number, number, number] = [-27, -27, 0];
  const projection = geoOrthographic().clipAngle(90).precision(.28).rotate(initialRotation);
  const path = geoPath(projection);
  const sphere = { type: 'Sphere' } as any;
  const graticule = geoGraticule10();
  let viewportWidth = 1600, viewportHeight = 900, baseScale = 900;
  let zoom = 1, targetZoom = 1, currentYear = -49, targetYear = -49;
  let timeDragging = false, globeDragging = false, lastX = 0, lastY = 0, velocityX = 0, velocityY = 0;
  let inertiaFrame = 0, wheelSnapTimer = 0, renderedEpoch = -1, renderedDetail = '', renderedFieldPair = '';
  let lastGeometryZoom = Number.NaN, lastGeometryRotation = '';

  const clamp = (value: number, low: number, high: number) => Math.max(low, Math.min(high, value));
  const formatYear = (year: number, spaced = true) => year < 0 ? `前${spaced ? ' ' : ''}${Math.abs(Math.round(year))}` : `公元${spaced ? ' ' : ''}${Math.round(year)}`;
  const siteHref = (href?: string) => href ? `${import.meta.env.BASE_URL}${href.replace(/^\//, '')}` : undefined;

  function epochPair(year: number) {
    const upper = worldEpochs.findIndex((epoch) => epoch.year >= year);
    if (upper <= 0) return [worldEpochs[0], worldEpochs[0], 0] as const;
    if (upper < 0) { const final = worldEpochs.at(-1)!; return [final, final, 0] as const; }
    const a = worldEpochs[upper - 1], b = worldEpochs[upper];
    return [a, b, (year - a.year) / (b.year - a.year)] as const;
  }
  function isVisible(coordinates: Coordinates, padding = .06) {
    const rotation = projection.rotate();
    return geoDistance(coordinates, [-rotation[0], -rotation[1]]) < Math.PI / 2 - padding;
  }
  function detailLevel() { return zoom >= 2.05 ? 'local' : zoom >= 1.3 ? 'region' : 'world'; }
  async function ensureRegionLand() {
    if (regionLand || regionLandLoading) return;
    regionLandLoading = true;
    const source = (await import('world-atlas/land-50m.json')).default as any;
    regionLand = topologyFeature(source);
    regionLandLoading = false;
    updateMapGeometry(true);
  }
  async function ensureLocalLand() {
    if (localLand || localLandLoading) return;
    localLandLoading = true;
    const source = (await import('world-atlas/land-10m.json')).default as any;
    localLand = topologyFeature(source);
    localLandLoading = false;
    updateMapGeometry(true);
  }
  function makeSvgElement(tag: string, className: string) {
    const element = document.createElementNS('http://www.w3.org/2000/svg', tag);
    element.setAttribute('class', className); return element;
  }

  const terrainElements = physicalFeatures.map((item) => {
    const line = makeSvgElement('path', `physical-feature ${item.kind}`);
    line.setAttribute('data-id', item.id); terrainLayer.append(line); return { item, line };
  });
  const placeElements = placeLabels.map((place) => {
    const element = document.createElement(place.href ? 'a' : 'span');
    element.className = `map-place ${place.importance}`; element.textContent = place.name;
    if (place.href) (element as HTMLAnchorElement).href = siteHref(place.href)!;
    placeLabelsLayer.append(element); return { place, element };
  });

  function fieldGeometry(field: (typeof worldEpochs)[number]['fields'][number]) {
    const seed = [...field.id].reduce((sum, char) => sum + char.charCodeAt(0), 0) * .017;
    const horizontal = field.radius * (field.confidence === 'influence' ? 1.35 : 1.18);
    const vertical = field.radius * (field.confidence === 'influence' ? .62 : .7);
    const ring: Coordinates[] = [];
    for (let index = 0; index <= 72; index += 1) {
      const angle = index / 72 * Math.PI * 2;
      const variation = 1 + Math.sin(angle * 3 + seed) * .065 + Math.cos(angle * 5 - seed) * .035;
      ring.push([field.center[0] + Math.cos(angle) * horizontal * variation, clamp(field.center[1] + Math.sin(angle) * vertical * variation, -82, 82)]);
    }
    return { type: 'Polygon', coordinates: [ring] } as any;
  }

  function renderFieldLayer(layer: HTMLElement, epochIndex: number) {
    const epoch = worldEpochs[epochIndex]; layer.replaceChildren();
    epoch.fields.forEach((field) => {
      const shape = makeSvgElement('path', `historical-field ${field.confidence}`);
      shape.setAttribute('d', path(fieldGeometry(field)) ?? ''); shape.style.setProperty('--field-color', field.color); shape.setAttribute('data-field', field.id); layer.append(shape);
    });
  }
  function renderEraLabels(epochIndex: number) {
    const epoch = worldEpochs[epochIndex]; eraLabels.replaceChildren();
    epoch.fields.forEach((field) => {
      const element = document.createElement(field.href ? 'a' : 'div');
      element.className = `era-label ${field.confidence}`; element.dataset.lon = String(field.center[0]); element.dataset.lat = String(field.center[1]);
      element.innerHTML = `<strong>${field.name}</strong><span>${field.era}</span>`;
      if (field.href) (element as HTMLAnchorElement).href = siteHref(field.href)!; eraLabels.append(element);
    });
  }
  function positionHtmlLabels() {
    eraLabels.querySelectorAll<HTMLElement>('.era-label').forEach((element) => {
      const coordinates: Coordinates = [Number(element.dataset.lon), Number(element.dataset.lat)];
      const point = projection(coordinates), visible = point && isVisible(coordinates, .12); element.hidden = !visible;
      if (point && visible) { element.style.left = `${point[0]}px`; element.style.top = `${point[1]}px`; }
    });
    placeElements.forEach(({ place, element }) => {
      const point = projection(place.coordinates), visible = zoom >= place.minZoom && point && isVisible(place.coordinates, .1); element.hidden = !visible;
      if (point && visible) { element.style.left = `${point[0]}px`; element.style.top = `${point[1]}px`; }
    });
  }
  function updateMapGeometry(force = false) {
    projection.scale(baseScale * zoom).translate([viewportWidth * .5, viewportHeight * .54]);
    const sphereD = path(sphere) ?? ''; spherePath.setAttribute('d', sphereD); sphereClipPath.setAttribute('d', sphereD); graticulePath.setAttribute('d', path(graticule) ?? '');
    const level = detailLevel();
    if (level === 'region' && !regionLand) void ensureRegionLand();
    if (level === 'local' && !localLand) void ensureLocalLand();
    const activeLand = level === 'world' ? worldLand : level === 'region' ? (regionLand ?? worldLand) : (localLand ?? regionLand ?? worldLand);
    landPath.setAttribute('d', path(activeLand) ?? '');
    if (force || renderedDetail !== level) {
      renderedDetail = level; root.dataset.detail = level;
      document.getElementById('scaleState')!.textContent = level === 'world' ? '世界尺度' : level === 'region' ? '地区尺度' : '局部尺度';
      document.getElementById('detailState')!.textContent = level === 'world' ? '文明与政权' : level === 'region' ? '山川、首都与边界' : '城市、河流与事件地点';
    }
    terrainElements.forEach(({ item, line }) => { line.setAttribute('d', path({ type: 'LineString', coordinates: item.coordinates } as any) ?? ''); line.style.opacity = zoom >= item.minZoom ? '1' : '0'; });
    const [a, b] = epochPair(currentYear), aIndex = worldEpochs.indexOf(a), bIndex = worldEpochs.indexOf(b);
    renderFieldLayer(fieldLayerA, aIndex); renderFieldLayer(fieldLayerB, bIndex); renderedFieldPair = `${aIndex}:${bIndex}`; positionHtmlLabels();
  }
  function updateEpochState() {
    const [a, b, blend] = epochPair(currentYear), near = blend < .5 ? a : b, nearIndex = worldEpochs.indexOf(near);
    fieldLayerA.style.opacity = String(1 - blend); fieldLayerB.style.opacity = String(blend);
    const aIndex = worldEpochs.indexOf(a), bIndex = worldEpochs.indexOf(b), pairKey = `${aIndex}:${bIndex}`;
    if (renderedFieldPair !== pairKey) { renderFieldLayer(fieldLayerA, aIndex); renderFieldLayer(fieldLayerB, bIndex); renderedFieldPair = pairKey; }
    if (renderedEpoch !== nearIndex) { renderedEpoch = nearIndex; renderEraLabels(nearIndex); positionHtmlLabels(); }
    const formatted = formatYear(currentYear); root.style.setProperty('--time-p', `${(currentYear - minYear) / (maxYear - minYear) * 100}%`);
    document.getElementById('instrumentYear')!.textContent = formatted.replace('公元 ', ''); document.getElementById('thumbYear')!.textContent = formatted.replace('公元 ', '');
    document.getElementById('epochYear')!.textContent = `${formatted} 年`; document.getElementById('epochTitle')!.textContent = near.title; rail.setAttribute('aria-valuenow', String(Math.round(currentYear)));
  }
  function resize() {
    const box = root.getBoundingClientRect(); viewportWidth = box.width; viewportHeight = box.height; svg.setAttribute('viewBox', `0 0 ${viewportWidth} ${viewportHeight}`);
    baseScale = viewportWidth < 720 ? Math.max(viewportWidth * .8, viewportHeight * .46) : Math.max(viewportWidth * .58, viewportHeight * .9); updateMapGeometry(true);
  }
  function animate() {
    const previousYear = currentYear;
    const zoomDelta = targetZoom - zoom; zoom = Math.abs(zoomDelta) < .0005 ? targetZoom : zoom + zoomDelta * .16;
    const yearDelta = targetYear - currentYear; currentYear = timeDragging ? targetYear : Math.abs(yearDelta) < .04 ? targetYear : currentYear + yearDelta * .18;
    if (Math.abs(currentYear - previousYear) > .001) updateEpochState();
    const rotationKey = projection.rotate().map((value) => value.toFixed(3)).join(':');
    if (Math.abs(zoom - lastGeometryZoom) > .0005 || rotationKey !== lastGeometryRotation) {
      updateMapGeometry(); lastGeometryZoom = zoom; lastGeometryRotation = rotationKey;
    }
    requestAnimationFrame(animate);
  }
  function yearFromPointer(event: PointerEvent) {
    const box = rail.getBoundingClientRect(), ratio = clamp((event.clientY - box.top) / box.height, 0, 1); return Math.round(minYear + ratio * (maxYear - minYear));
  }
  function snapYear(year: number) {
    const nearest = worldEpochs.reduce((best, item) => Math.abs(item.year - year) < Math.abs(best.year - year) ? item : best); return Math.abs(nearest.year - year) <= 28 ? nearest.year : year;
  }

  rail.addEventListener('pointerdown', (event) => { timeDragging = true; targetYear = yearFromPointer(event); currentYear = targetYear; rail.setPointerCapture(event.pointerId); root.dataset.timeDragging = 'true'; event.preventDefault(); });
  rail.addEventListener('pointermove', (event) => { if (timeDragging) { targetYear = yearFromPointer(event); currentYear = targetYear; } });
  rail.addEventListener('pointerup', (event) => { if (!timeDragging) return; targetYear = snapYear(yearFromPointer(event)); timeDragging = false; delete root.dataset.timeDragging; });
  document.getElementById('timeInstrument')!.addEventListener('wheel', (event) => { event.preventDefault(); targetYear = clamp(targetYear + (event.deltaY > 0 ? 9 : -9), minYear, maxYear); window.clearTimeout(wheelSnapTimer); wheelSnapTimer = window.setTimeout(() => targetYear = snapYear(targetYear), 170); }, { passive: false });
  rail.addEventListener('keydown', (event) => { const steps: Record<string, number> = { ArrowUp: -10, ArrowDown: 10, PageUp: -50, PageDown: 50 }; if (event.key === 'Home') targetYear = minYear; else if (event.key === 'End') targetYear = maxYear; else if (steps[event.key]) targetYear = clamp(targetYear + steps[event.key], minYear, maxYear); else return; event.preventDefault(); });
  document.querySelectorAll<HTMLElement>('.time-stop').forEach((stop) => stop.addEventListener('click', () => targetYear = Number(stop.dataset.year)));

  root.addEventListener('pointerdown', (event) => {
    if ((event.target as HTMLElement).closest('.time-instrument,.map-controls,.intro,.era-label,.map-place,a,button')) return;
    globeDragging = true; lastX = event.clientX; lastY = event.clientY; velocityX = velocityY = 0; cancelAnimationFrame(inertiaFrame); root.setPointerCapture(event.pointerId); root.dataset.globeDragging = 'true'; event.preventDefault();
  });
  root.addEventListener('pointermove', (event) => {
    if (!globeDragging) return; const dx = event.clientX - lastX, dy = event.clientY - lastY, rotation = projection.rotate(), sensitivity = .19 / Math.sqrt(zoom);
    velocityX = dx * sensitivity; velocityY = -dy * sensitivity; projection.rotate([rotation[0] + velocityX, clamp(rotation[1] + velocityY, -74, 74), 0]); lastX = event.clientX; lastY = event.clientY;
  });
  function coast() { if (Math.abs(velocityX) + Math.abs(velocityY) < .018) return; const rotation = projection.rotate(); projection.rotate([rotation[0] + velocityX, clamp(rotation[1] + velocityY, -74, 74), 0]); velocityX *= .9; velocityY *= .9; inertiaFrame = requestAnimationFrame(coast); }
  root.addEventListener('pointerup', () => { if (!globeDragging) return; globeDragging = false; delete root.dataset.globeDragging; coast(); });
  root.addEventListener('wheel', (event) => { if ((event.target as HTMLElement).closest('.time-instrument')) return; event.preventDefault(); targetZoom = clamp(targetZoom * Math.exp(-event.deltaY * .001), .82, 3.25); }, { passive: false });
  document.getElementById('zoomIn')!.addEventListener('click', () => targetZoom = clamp(targetZoom * 1.3, .82, 3.25));
  document.getElementById('zoomOut')!.addEventListener('click', () => targetZoom = clamp(targetZoom / 1.3, .82, 3.25));
  document.getElementById('resetView')!.addEventListener('click', () => { projection.rotate(initialRotation); targetZoom = 1; });
  window.addEventListener('resize', resize); resize(); updateEpochState(); animate();
</script>

<style is:global>
  .world{position:absolute;inset:0;overflow:hidden;background:radial-gradient(circle at 43% 42%,rgba(79,91,74,.13),transparent 46%),#0c0f0e;user-select:none;-webkit-user-select:none;touch-action:none}
  .world-map{position:absolute;inset:0;width:100%;height:100%;cursor:grab}[data-globe-dragging=true] .world-map{cursor:grabbing}
  .sphere{fill:url(#oceanGlow);stroke:rgba(128,151,137,.34);stroke-width:1.2}.land{fill:url(#landWash);stroke:#59685e;stroke-width:.72;stroke-opacity:.7;vector-effect:non-scaling-stroke}.graticule{fill:none;stroke:#819084;stroke-width:.48;stroke-opacity:.12;vector-effect:non-scaling-stroke}
  .historical-fields{transition:opacity .22s linear}.historical-field{fill:var(--field-color);fill-opacity:.24;stroke:color-mix(in srgb,var(--field-color) 76%,#f0e4ce);stroke-width:1.15;stroke-opacity:.58;vector-effect:non-scaling-stroke}.historical-field.approximate{stroke-dasharray:5 3}.historical-field.influence{fill-opacity:.18;stroke-width:5;stroke-opacity:.14;filter:url(#fieldSoft)}
  .physical-feature{fill:none;vector-effect:non-scaling-stroke;transition:opacity .35s}.physical-feature.river{stroke:#7898a3;stroke-width:1.25;stroke-opacity:.72}.physical-feature.mountain{stroke:#a99b7b;stroke-width:4;stroke-linecap:round;stroke-dasharray:1 8;stroke-opacity:.48}
  .era-labels,.place-labels{position:absolute;inset:0;pointer-events:none}.era-label,.map-place{position:absolute;z-index:5;transform:translate(-50%,-50%);text-decoration:none;pointer-events:auto}.era-label{display:grid;justify-items:center;gap:.16rem;width:max-content;max-width:13rem;color:#eee6d8;text-align:center;text-shadow:0 1px 2px #080b09,0 2px 12px #080b09,0 0 3px #080b09}.era-label strong{font:620 clamp(.93rem,1.16vw,1.18rem)/1.2 var(--l-font-display);letter-spacing:.025em}.era-label span{color:#c0b8aa;font:500 .76rem/1.35 var(--l-font-body)}.era-label.influence:before{content:'';width:1.9rem;height:1px;margin-bottom:.12rem;background:rgba(225,215,194,.45)}[data-detail=local] .era-label span{opacity:.7}
  .map-place{padding-left:.7rem;color:#e5ddd0;font:500 .78rem/1.3 var(--l-font-body);white-space:nowrap;text-shadow:0 1px 2px #050806,0 0 7px #050806}.map-place:before{content:'';position:absolute;left:0;top:.4em;width:5px;height:5px;border:1px solid #d2b276;border-radius:50%;background:#19201c}.map-place.capital{color:#efdcb9;font-weight:620}.map-place.site{color:#e0bb76}
  .intro{position:absolute;left:clamp(1.5rem,5vw,5.6rem);top:clamp(7rem,22vh,14rem);width:min(31rem,34vw);pointer-events:none}.intro p{margin:0 0 1.2rem;color:#c49a5c;font:600 .72rem/1 var(--l-font-body);letter-spacing:.2em}.intro h1{margin:0;color:#eee8dc;font:560 clamp(2.8rem,4.5vw,4.8rem)/1.08 var(--l-font-display);letter-spacing:-.025em;text-wrap:balance;text-shadow:0 4px 30px rgba(0,0,0,.55)}.intro div{width:min(28rem,100%);margin-top:1.4rem;color:#b8b1a5;font:440 clamp(.96rem,1.05vw,1.08rem)/1.75 var(--l-font-body);text-shadow:0 2px 9px #080b09}
  .epoch-heading{position:absolute;left:50%;top:5.9rem;display:grid;justify-items:center;gap:.28rem;transform:translateX(-50%);text-align:center;pointer-events:none}.epoch-heading span{color:#c69c5d;font:600 .76rem/1 var(--l-font-body);letter-spacing:.12em}.epoch-heading strong{color:#ddd6ca;font:540 1.08rem/1.3 var(--l-font-display);letter-spacing:.04em}
