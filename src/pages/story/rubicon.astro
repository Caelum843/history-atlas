---
import { getCollection, getEntry } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import ObjectDrawer from '../../components/ObjectDrawer.astro';
import { BOUNDS, regionView } from '../../lib/geo';
import { assertContentValid } from '../../lib/validate';
import { sitePath } from '../../lib/paths';

await assertContentValid();

const scene = await getEntry('scenes', 'rubicon');
if (!scene) throw new Error('缺少 rubicon 场景');
const chapter = await getEntry('chapters', 'rubicon');
if (!chapter) throw new Error('缺少 rubicon 知识章节');
const work = await getEntry('works', scene.data.work);
const world = await getCollection('world');
const sources = await getCollection('sources');
const byWorldId = new Map(world.map((node) => [node.id, node]));
const bySourceId = new Map(sources.map((source) => [source.id, source]));

const [, authorityBeat, procedureBeat] = scene.data.beats;
const authorityConfig = authorityBeat.visual.config as any;
const procedureConfig = procedureBeat.visual.config as any;

const VB = { width: 1280, height: 760 };
const map = regionView(VB, BOUNDS.mediterranean, 0);
const mapNodeIds = ['rome-city', 'ravenna', 'ariminum'];
const mapNodes = mapNodeIds
  .map((id) => byWorldId.get(id))
  .filter((node) => node?.data.lon !== undefined && node.data.lat !== undefined)
  .map((node) => ({
    node: node!,
    point: map.project(node!.data.lon!, node!.data.lat!),
    label: node!.id === 'ravenna'
      ? { dx: -12, dy: -8, anchor: 'end' }
      : node!.id === 'ariminum'
        ? { dx: 13, dy: 17, anchor: 'start' }
        : { dx: 13, dy: 5, anchor: 'start' },
  }));
const ravenna = byWorldId.get('ravenna');
const ariminum = byWorldId.get('ariminum');
const march = ravenna && ariminum
  ? map.line([[ravenna.data.lon!, ravenna.data.lat!], [ariminum.data.lon!, ariminum.data.lat!]])
  : '';

const STATUS_ZH: Record<string, string> = {
  attested: '有直接史料支持', inferred: '推断', disputed: '存在争议', legend: '后世附会',
};

const evidence = Object.fromEntries(scene.data.beats.flatMap((beat) => beat.claims.map((claim) => [
  claim.id,
  {
    beat: beat.title.zh,
    text: claim.text.zh,
    status: claim.status,
    statusLabel: STATUS_ZH[claim.status],
    uncertainty: claim.uncertainty?.zh ?? '',
    citations: claim.citations.map((citation) => {
      const source = bySourceId.get(citation.source);
      return {
        source: source?.data.title.zh ?? citation.source,
        locus: citation.locus ?? '',
        relation: citation.relation,
        note: citation.note?.zh ?? '',
      };
    }),
    alternatives: claim.alternatives?.map((alternative) => alternative.text.zh) ?? [],
  },
])));
---

<Shell
  layer="story"
  title="卢比孔河 · 共和国危机"
  context="故事 · 卢比孔河"
  up={{ href: '/world/rome-republic/', label: '返回罗马卷' }}
>
  <div class="story" id="story">
    <div class="stage" id="stage" data-act="0">
      <div class="stage__grain" aria-hidden="true"></div>

      <section class="visual visual--geography" aria-label="前 49 年地中海空间">
        <svg viewBox={`0 0 ${VB.width} ${VB.height}`} role="img" aria-label="真实海岸轮廓上的拉文纳、里米尼与罗马">
          <path d={map.land} class="geo__land" />
          <path d={march} class="geo__march" />
          {mapNodes.map(({ node, point, label }) => (
            <g class={`geo__place geo__place--${node.id}`}>
              <circle cx={point[0]} cy={point[1]} r={node.id === 'rome-city' ? 7 : 5} />
              <text x={point[0] + label.dx} y={point[1] + label.dy} text-anchor={label.anchor}>{node.data.title.zh}</text>
            </g>
          ))}
        </svg>
        <p class="visual__accuracy"><span>SURVEY</span> 现代海岸轮廓仅作空间参照 · 不绘制现代国界</p>
        <div class="geo__authority">
          <span>CAESAR · IMPERIUM</span>
          <strong>军权在受命行省内有效</strong>
          <em>空间关系是这一幕的论点</em>
        </div>
      </section>

      <section class="visual visual--authority" aria-label="军事权限的四条轨道">
        <div class="authority__header">
          <span>IMPERIUM · 四个侧面并不同步变化</span>
          <strong>越河不是所有事情<br />同时改变的瞬间</strong>
        </div>
        <div class="authority__grid">
          <div class="authority__axis">
            {authorityConfig.nodes.map((node: any) => <span class={node.pivot ? 'is-pivot' : ''}>{node.label.zh}</span>)}
          </div>
          {authorityConfig.tracks.map((track: any) => (
            <div class="authority__track">
              <span class="authority__label">{track.label.zh}</span>
              <div class="authority__cells">
                {track.cells.map((cell: any) => (
                  <button
                    class:list={['authority__cell', `st-${cell.status}`, { 'is-changed': cell.changed }]}
                    data-evidence={cell.claims?.[0]}
                    disabled={!cell.claims?.length}
                  >
                    <i></i><span>{cell.label.zh}</span>
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>
        <div class="procedure">
          <p>在越河以前，政治程序已经逐级收紧</p>
          <ol>
            {procedureConfig.stages.map((step: any, index: number) => (
              <li class={`procedure--${step.outcome}`}>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{step.label.zh}</strong>
                <em>{step.timeLabel?.zh ?? step.outcome}</em>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="visual visual--uncertainty" aria-label="卢比孔河位置存在争议">
        <div class="uncertainty__field" aria-hidden="true">
          <svg viewBox="0 0 1000 700" preserveAspectRatio="none">
            <path d="M110 80 C190 195 145 275 260 390 S430 520 350 690" />
            <path d="M390 20 C475 130 405 255 530 365 S650 520 620 710" />
            <path d="M725 -20 C640 120 760 240 680 370 S770 550 855 720" />
          </svg>
          <span class="candidate candidate--a">候选河道 A</span>
          <span class="candidate candidate--b">候选河道 B</span>
          <span class="candidate candidate--c">候选河道 C</span>
        </div>
        <div class="uncertainty__statement">
          <p>POSITION DISPUTED</p>
          <h2>证据精度<br />在这里耗尽</h2>
          <span>我们知道凯撒率军离开了受命行省。我们不知道古代界河对应今天的哪一条河道。</span>
          <button data-object="rubico">打开“卢比孔河”对象与关联</button>
        </div>
        <p class="uncertainty__rule">此尺度无可确证的古代测绘数据 · 不绘制确定河道或伪精确边界</p>
      </section>

      <nav class="progress" aria-label="故事进度">
        <button class="is-current" data-goto="0"><span>01</span>空间边界</button>
        <button data-goto="1"><span>02</span>制度失效</button>
        <button data-goto="2"><span>03</span>行动与记忆</button>
      </nav>
    </div>

    <div class="scroll" id="scroll">
      {chapter.data.segments.map((segment, index) => (
        <article
          class:list={['beat', { 'beat--right': index % 2 === 1 }]}
          data-beat={segment.act}
          data-role={segment.role}
        >
          <div class="beat__copy">
            <p class="beat__meta">{String(index + 1).padStart(2, '0')} / {String(chapter.data.segments.length).padStart(2, '0')} · {segment.eyebrow.zh}</p>
            {index === 0 ? <h1>{segment.title.zh}</h1> : <h2>{segment.title.zh}</h2>}
            {segment.body.map((paragraph) => <p>{paragraph.zh}</p>)}
            {segment.keyPoint && <blockquote><span>本段结论</span>{segment.keyPoint.zh}</blockquote>}
            {(segment.entities.length > 0 || segment.claimRefs.length > 0) && (
              <div class="beat__objects">
                {segment.entities.map((id) => (
                  <button data-object={id}>{byWorldId.get(id)?.data.title.zh ?? id}</button>
                ))}
                {segment.claimRefs.map((id) => (
                  <button data-evidence={id}>论断依据 · {evidence[id]?.statusLabel ?? '待核'}</button>
                ))}
              </div>
            )}
            {index < chapter.data.segments.length - 1
              ? <span class="beat__scroll">继续阅读 ↓</span>
              : <a class="beat__return" href={sitePath('/world/rome-republic/')}>带着这一章回到共和国危机卷 ↑</a>}
          </div>
        </article>
      ))}
    </div>
  </div>

  <ObjectDrawer slot="overlay" />

  <aside class="evidence" id="evidence" data-open="false" aria-hidden="true" slot="overlay">
    <button class="evidence__close" id="evidenceClose" aria-label="关闭证据">×</button>
    <div id="evidenceBody"></div>
  </aside>
  <script type="application/json" id="evidenceData" set:html={JSON.stringify(evidence)} is:inline slot="overlay"></script>
</Shell>

<script>
  const scroll = document.getElementById('scroll')!;
  const stage = document.getElementById('stage')!;
  const beats = [...document.querySelectorAll<HTMLElement>('[data-beat]')];
  const progress = [...document.querySelectorAll<HTMLButtonElement>('[data-goto]')];

  function setAct(act: number) {
    stage.dataset.act = String(act);
    progress.forEach((button, index) => button.classList.toggle('is-current', index === act));
  }

  const observer = new IntersectionObserver((entries) => {
    const visible = entries
      .filter((entry) => entry.isIntersecting)
      .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
    if (visible) setAct(Number((visible.target as HTMLElement).dataset.beat));
  }, { root: scroll, threshold: [.35, .55, .75] });
  beats.forEach((beat) => observer.observe(beat));

  progress.forEach((button) => button.addEventListener('click', () => {
    beats.find((beat) => Number(beat.dataset.beat) === Number(button.dataset.goto))
      ?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));

  const evidenceData = JSON.parse(document.getElementById('evidenceData')!.textContent!);
  const evidenceDrawer = document.getElementById('evidence')!;
  const evidenceBody = document.getElementById('evidenceBody')!;
  const evidenceClose = document.getElementById('evidenceClose')!;

  const escapeHtml = (value: string) => value.replace(/[&<>\"]/g, (character) =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[character]!));

  function openEvidence(id: string) {
    const item = evidenceData[id];
    if (!item) return;
    const citations = item.citations.length
      ? item.citations.map((citation: any) => `<li><strong>${escapeHtml(citation.source)}</strong><span>${escapeHtml(citation.locus)} · ${escapeHtml(citation.relation)}</span>${citation.note ? `<p>${escapeHtml(citation.note)}</p>` : ''}</li>`).join('')
      : '<li class="is-pending">详细引注将在 M3 补充；当前论断已标明证据状态，不以空白冒充确证。</li>';
    const alternatives = item.alternatives.length
      ? `<div class="evidence__alternatives"><p>替代解释</p>${item.alternatives.map((text: string) => `<span>${escapeHtml(text)}</span>`).join('')}</div>`
      : '';
    evidenceBody.innerHTML = `
      <p class="evidence__beat">${escapeHtml(item.beat)}</p>
      <p class="evidence__status st-${escapeHtml(item.status)}">${escapeHtml(item.statusLabel)}</p>
      <h2>${escapeHtml(item.text)}</h2>
      ${item.uncertainty ? `<p class="evidence__uncertainty">${escapeHtml(item.uncertainty)}</p>` : ''}
      ${alternatives}
      <p class="evidence__section">来源与定位</p><ol>${citations}</ol>`;
    evidenceDrawer.dataset.open = 'true';
    evidenceDrawer.setAttribute('aria-hidden', 'false');
    evidenceClose.focus();
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const opener = target.closest<HTMLElement>('[data-evidence]');
    if (opener?.dataset.evidence) openEvidence(opener.dataset.evidence);
    if (target.closest('#evidenceClose')) {
      evidenceDrawer.dataset.open = 'false';
      evidenceDrawer.setAttribute('aria-hidden', 'true');
    }
  });
</script>

<style>
  .story { position: absolute; inset: 0; overflow: hidden; }
  .stage { position: absolute; inset: 0; background: var(--act-ground); transition: background 1s ease; }
  .stage__grain { position: absolute; inset: 0; z-index: 8; pointer-events: none; opacity: .08; background-image: repeating-linear-gradient(0deg, transparent 0 3px, rgba(255,255,255,.025) 3px 4px); }
  .visual { position: absolute; inset: 0; opacity: 0; visibility: hidden; transform: scale(1.025); transition: opacity .8s ease, transform 1.2s ease, visibility 0s linear .8s; }
  .stage[data-act="0"] .visual--geography, .stage[data-act="1"] .visual--authority, .stage[data-act="2"] .visual--uncertainty { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }

  .visual--geography svg { width: 100%; height: 100%; display: block; }
  .geo__land { fill: var(--act-land); stroke: var(--act-edge); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .geo__march { fill: none; stroke: var(--l-accent); stroke-width: 1.5; stroke-dasharray: 4 7; vector-effect: non-scaling-stroke; }
  .geo__place circle { fill: var(--l-ink); stroke: var(--act-ground); stroke-width: 3; }
  .geo__place text { fill: var(--l-ink-dim); font: 12px var(--l-font-body); }
  .geo__place--rome-city circle { fill: var(--l-accent); }
  .visual__accuracy { position: absolute; right: 3vw; top: 10vh; margin: 0; color: var(--l-ink-faint); font: .52rem var(--l-font-mono); letter-spacing: .12em; }
  .visual__accuracy span { color: var(--l-cool); margin-right: .65rem; }
  .geo__authority { position: absolute; right: 5vw; bottom: 11vh; width: min(23rem, 30vw); padding: 1rem 1.2rem; border: 1px solid var(--l-rule); background: rgba(8,10,11,.75); }
  .geo__authority span, .geo__authority em { display: block; color: var(--l-accent); font: .52rem var(--l-font-mono); letter-spacing: .15em; font-style: normal; }
  .geo__authority strong { display: block; margin: .55rem 0; color: var(--l-ink); font: 300 .95rem var(--l-font-body); }
  .geo__authority em { color: var(--l-ink-faint); letter-spacing: .08em; }

  .visual--authority { padding: 11vh 6vw 8vh; background: radial-gradient(circle at 70% 40%, rgba(93,70,35,.11), transparent 30%); }
  .authority__header { position: absolute; left: 6vw; top: 11vh; }
  .authority__header span { color: var(--l-accent); font: .54rem var(--l-font-mono); letter-spacing: .16em; }
  .authority__header strong { display: block; margin-top: .8rem; color: var(--l-ink); font: 300 clamp(1.8rem,3vw,3rem)/1.15 var(--l-font-display); }
  .authority__grid { position: absolute; left: 35vw; right: 5vw; top: 15vh; }
  .authority__axis { margin-left: 9rem; display: grid; grid-template-columns: repeat(4,1fr); color: var(--l-ink-faint); font: .5rem var(--l-font-mono); text-align: center; }
  .authority__axis .is-pivot { color: var(--l-accent); }
  .authority__track { display: grid; grid-template-columns: 9rem 1fr; align-items: center; margin-top: 1.15rem; }
  .authority__label { padding-right: 1rem; color: var(--l-ink-dim); font-size: .7rem; text-align: right; }
  .authority__cells { position: relative; display: grid; grid-template-columns: repeat(4,1fr); }
  .authority__cells::before { content: ''; position: absolute; left: 0; right: 0; top: 6px; height: 2px; background: var(--l-rule); }
  .authority__cell { position: relative; min-width: 0; padding: 1.5rem .35rem 0; border: 0; background: none; color: var(--l-ink-faint); font: .52rem/1.45 var(--l-font-body); cursor: pointer; }
  .authority__cell:disabled { cursor: default; }
  .authority__cell i { position: absolute; top: 2px; left: calc(50% - 4px); width: 8px; height: 8px; border-radius: 50%; background: var(--l-ink-faint); }
  .authority__cell.is-changed { color: var(--l-ink); }
  .authority__cell.is-changed i { background: var(--l-accent); box-shadow: 0 0 0 5px rgba(201,161,91,.09); }
  .authority__cell.st-disputed i { border: 1px solid var(--l-cool); background: var(--act-ground); }
  .procedure { position: absolute; left: 6vw; bottom: 7vh; width: 83vw; }
  .procedure > p { margin: 0 0 .55rem; color: var(--l-ink-faint); font: .5rem var(--l-font-mono); letter-spacing: .12em; }
  .procedure ol { display: grid; grid-template-columns: repeat(5,1fr); gap: 1px; list-style: none; margin: 0; padding: 0; background: var(--l-rule); }
  .procedure li { min-width: 0; padding: .65rem; background: var(--act-ground); display: grid; grid-template-columns: auto 1fr; gap: .2rem .5rem; }
  .procedure span, .procedure em { color: var(--l-ink-faint); font: .45rem var(--l-font-mono); font-style: normal; }
  .procedure strong { min-width: 0; color: var(--l-ink-dim); font: 300 .62rem var(--l-font-body); }
  .procedure em { grid-column: 2; }
  .procedure--extraordinary { box-shadow: inset 0 -2px var(--l-accent); }

  .visual--uncertainty { background: radial-gradient(circle at 50% 45%, #17191a, #090b0c 68%); }
  .uncertainty__field { position: absolute; inset: 0; opacity: .72; }
  .uncertainty__field::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.018) 1px, transparent 1px); background-size: 6vw 6vw; mask-image: radial-gradient(circle, black, transparent 72%); }
  .uncertainty__field svg { width: 100%; height: 100%; }
  .uncertainty__field path { fill: none; stroke: var(--l-ink-dim); stroke-width: 1; stroke-dasharray: 7 9; opacity: .5; }
  .candidate { position: absolute; color: var(--l-ink-faint); font: .48rem var(--l-font-mono); letter-spacing: .12em; }
  .candidate--a { left: 24%; top: 56%; }.candidate--b { left: 53%; top: 37%; }.candidate--c { left: 76%; top: 62%; }
  .uncertainty__statement { position: absolute; right: 9vw; top: 16vh; width: min(31rem,38vw); padding: 1.5rem 1.7rem; background: rgba(7,9,10,.82); border-left: 2px solid var(--l-cool); }
  .uncertainty__statement > p { margin: 0; color: var(--l-cool); font: .54rem var(--l-font-mono); letter-spacing: .18em; }
  .uncertainty__statement h2 { margin: .8rem 0 1rem; color: var(--l-ink); font: 300 clamp(2.2rem,4.5vw,4.6rem)/.94 var(--l-font-display); }
  .uncertainty__statement > span { display: block; color: var(--l-ink-dim); font-size: .82rem; line-height: 1.9; }
  .uncertainty__statement button { margin-top: 1.2rem; padding: .6rem .75rem; border: 1px solid var(--l-rule); background: none; color: var(--l-ink-dim); font: .54rem var(--l-font-mono); letter-spacing: .1em; cursor: pointer; }
  .uncertainty__statement button:hover { border-color: var(--l-cool); color: var(--l-ink); }
  .uncertainty__rule { position: absolute; right: 4vw; bottom: 9vh; color: var(--l-ink-faint); font: .48rem var(--l-font-mono); letter-spacing: .12em; }

  .progress { position: fixed; z-index: 20; right: 2.4vw; top: 40%; display: flex; flex-direction: column; align-items: flex-end; gap: .3rem; }
  .progress button { border: 0; border-right: 1px solid var(--l-rule); padding: .35rem .75rem .35rem .4rem; background: none; color: transparent; font: .48rem var(--l-font-mono); letter-spacing: .08em; cursor: pointer; transition: color .25s,border-color .25s; }
  .progress button span { color: var(--l-ink-faint); margin-right: .5rem; }
  .progress button:hover, .progress button.is-current { color: var(--l-ink-dim); border-color: var(--l-accent); }
  .progress button.is-current span { color: var(--l-accent); }

  .scroll { position: absolute; z-index: 12; inset: 0; overflow-y: auto; scroll-snap-type: y mandatory; }
  .beat { min-height: 100vh; scroll-snap-align: start; display: flex; align-items: center; padding: 12vh 7vw; pointer-events: none; }
  .beat--right { justify-content: flex-end; padding-right: 10vw; }
  .beat__copy { width: min(31rem,42vw); padding: 1.6rem 1.8rem; background: rgba(7,9,10,.80); border-left: 2px solid var(--l-accent); box-shadow: 0 20px 60px rgba(0,0,0,.22); pointer-events: auto; }
  .beat__meta { margin: 0; color: var(--l-accent); font: .54rem var(--l-font-mono); letter-spacing: .17em; }
  .beat__copy h1, .beat__copy h2 { margin: .9rem 0 1rem; color: var(--l-ink); font: 300 clamp(2.2rem,4vw,4.1rem)/1 var(--l-font-display); }
  .beat__copy h2 { font-size: clamp(1.9rem,3.3vw,3.5rem); }
  .beat__copy > p:not(.beat__meta) { color: var(--l-ink-dim); font-size: .88rem; line-height: 1.9; }
  .beat__copy blockquote { display: grid; gap: .45rem; margin: 1.1rem 0 0; padding: .75rem .9rem; border: 0; border-left: 1px solid var(--l-cool); background: rgba(127,163,186,.045); color: var(--l-ink); font-size: .76rem; line-height: 1.75; }
  .beat__copy blockquote span { color: var(--l-cool); font: .48rem var(--l-font-mono); letter-spacing: .14em; }
  .beat__objects { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1rem; }
  .beat__objects button { border: 1px solid var(--l-rule); padding: .48rem .65rem; background: rgba(0,0,0,.2); color: var(--l-ink-dim); font: .55rem var(--l-font-mono); cursor: pointer; }
  .beat__objects button:hover { border-color: var(--l-accent); color: var(--l-ink); }
  .beat__scroll { display: block; margin-top: 1.2rem; color: var(--l-ink-faint); font: .48rem var(--l-font-mono); letter-spacing: .1em; }
  .beat__return { display: inline-block; margin-top: 1.3rem; color: var(--l-accent); font: .55rem var(--l-font-mono); letter-spacing: .1em; text-decoration: none; }

  .evidence { position: fixed; z-index: 100; right: 0; top: 0; width: min(510px,94vw); height: 100%; padding: 5rem 2rem 2rem; overflow-y: auto; background: #111313; border-left: 1px solid var(--l-cool); transform: translateX(101%); transition: transform .45s cubic-bezier(.22,.8,.22,1); box-shadow: -30px 0 80px rgba(0,0,0,.65); }
  .evidence[data-open="true"] { transform: none; }
  .evidence__close { position: absolute; right: 1.4rem; top: 1.2rem; border: 0; background: none; color: var(--l-ink-dim); font-size: 1.3rem; cursor: pointer; }
