---
import { getCollection } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import ObjectDrawer from '../../components/ObjectDrawer.astro';
import { BOUNDS, regionView } from '../../lib/geo';
import { sitePath } from '../../lib/paths';

export async function getStaticPaths() {
  const nodes = await getCollection('world');
  return nodes
    .filter((node) => node.data.entry?.startsWith('/entity/'))
    .map((node) => ({ params: { id: node.id }, props: { node } }));
}

const { node } = Astro.props;
const world = await getCollection('world');
const byId = new Map(world.map((entry) => [entry.id, entry]));
const related = node.data.related.map((id: string) => byId.get(id)).filter(Boolean);

const TYPE_ZH: Record<string, string> = {
  person: '人物', place: '地点', institution: '制度', artefact: '文献 / 文物',
  story: '故事', region: '地区', event: '事件',
};

const isPlace = node.data.type === 'place';
const VB = { width: 900, height: 640 };
const map = regionView(VB, BOUNDS.italy, 25);
const point = isPlace && node.data.lon !== undefined && node.data.lat !== undefined
  ? map.project(node.data.lon, node.data.lat)
  : null;
---

<Shell
  layer="realm"
  identity="rome-republic"
  title={`${node.data.title.zh} · History Atlas`}
  context={`${TYPE_ZH[node.data.type] ?? node.data.type} · ${node.data.title.zh}`}
  up={{ href: '/world/rome-republic/', label: '返回罗马卷' }}
>
  <article class:list={['entity', `entity--${node.data.type}`]}>
    <div class="entity__field" aria-hidden="true">
      {isPlace && point ? (
        <svg viewBox={`0 0 ${VB.width} ${VB.height}`}>
          <path d={map.land} />
          <circle cx={point[0]} cy={point[1]} r="7" />
          <circle class="pulse" cx={point[0]} cy={point[1]} r="26" />
        </svg>
      ) : (
        <div class="entity__monogram">{node.data.title.en?.slice(0, 1) ?? node.data.title.zh.slice(0, 1)}</div>
      )}
    </div>

    <header class="entity__header">
      <p>{TYPE_ZH[node.data.type] ?? node.data.type}</p>
      <h1>{node.data.title.zh}</h1>
      {node.data.title.en && <span>{node.data.title.en}</span>}
      <div class="entity__rule"></div>
      <p class="entity__summary">{node.data.summary?.zh}</p>
      {node.data.positionDisputed && (
        <aside>
          <strong>POSITION DISPUTED</strong>
          <span>古代位置不可考，因此本页不提供一个伪精确坐标。</span>
        </aside>
      )}
    </header>

    <section class="entity__doors" aria-labelledby="doors-title">
      <div class="doors__head">
        <p id="doors-title">从这个对象继续进入</p>
        <span>{related.length} 条关系 · 没有叶子节点</span>
      </div>
      <ol>
        {related.map((target: any, index: number) => (
          <li>
            {target.data.entry && !target.data.planned ? (
              <a href={sitePath(target.data.entry)}>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{target.data.title.zh}</strong>
                <em>{TYPE_ZH[target.data.type]}</em>
                <i>→</i>
              </a>
            ) : (
              <button data-object={target.id}>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{target.data.title.zh}</strong>
                <em>{target.data.planned ? '规划中' : TYPE_ZH[target.data.type]}</em>
                <i>＋</i>
              </button>
            )}
          </li>
        ))}
      </ol>
    </section>

    <a class="entity__story" href={sitePath('/story/rubicon/')}>
      <span>当前开放故事</span>
      <strong>回到《卢比孔河》</strong>
      <i>→</i>
    </a>
  </article>

  <ObjectDrawer slot="overlay" />
</Shell>

<style>
  .entity { position: absolute; inset: 0; overflow: hidden; background: radial-gradient(circle at 65% 45%, rgba(95,73,38,.12), transparent 36%), var(--l-ground); }
  .entity::after { content: ''; position: absolute; inset: 0; pointer-events: none; box-shadow: inset 0 0 14vw rgba(0,0,0,.52); }
  .entity__field { position: absolute; left: 41%; right: 0; top: 0; bottom: 0; overflow: hidden; opacity: .62; }
  .entity__field svg { width: 100%; height: 100%; }
  .entity__field path { fill: var(--l-land); stroke: var(--l-land-edge); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .entity__field circle:not(.pulse) { fill: var(--l-accent); }
  .entity__field .pulse { fill: none; stroke: var(--l-accent); stroke-width: 1; opacity: .55; }
  .entity__monogram { position: absolute; right: -4vw; top: 8vh; color: var(--l-stone); font: 400 min(55vw,48rem)/1 var(--l-font-display); }
  .entity--institution .entity__monogram { font-family: var(--l-font-mono); opacity: .7; }
  .entity--artefact .entity__monogram { transform: rotate(-8deg); }

  .entity__header { position: absolute; z-index: 3; left: 6vw; top: 18vh; width: min(31rem,35vw); }
  .entity__header > p:first-child { margin: 0 0 .8rem; color: var(--l-accent); font: .55rem var(--l-font-mono); letter-spacing: .18em; }
  .entity__header h1 { margin: 0; color: var(--l-ink); font: 400 clamp(2.4rem,5vw,5rem)/1.03 var(--l-font-display); }
  .entity__header > span { display: block; margin-top: .5rem; color: var(--l-ink-faint); font: .62rem var(--l-font-mono); letter-spacing: .14em; }
  .entity__rule { width: 5rem; height: 1px; margin: 1.5rem 0; background: var(--l-accent-dim); }
  .entity__summary { color: var(--l-ink-dim); font-size: .9rem; line-height: 1.95; }
  .entity__header aside { margin-top: 1rem; padding: .8rem 1rem; border-left: 1px solid var(--l-cool); background: rgba(125,155,176,.05); }
  .entity__header aside strong, .entity__header aside span { display: block; }
  .entity__header aside strong { color: var(--l-cool); font: .52rem var(--l-font-mono); letter-spacing: .15em; }
  .entity__header aside span { margin-top: .45rem; color: var(--l-ink-dim); font-size: .72rem; line-height: 1.7; }

  .entity__doors { position: absolute; z-index: 4; right: 5vw; top: 17vh; width: min(31rem,39vw); }
  .doors__head { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: .7rem; border-bottom: 1px solid var(--l-rule); }
  .doors__head p, .doors__head span { margin: 0; color: var(--l-ink-faint); font: .52rem var(--l-font-mono); letter-spacing: .13em; }
  .entity__doors ol { list-style: none; padding: 0; margin: 0; }
  .entity__doors a, .entity__doors button { width: 100%; display: grid; grid-template-columns: 2rem 1fr auto auto; gap: .65rem; align-items: center; padding: .9rem .7rem; border: 0; border-bottom: 1px solid var(--l-rule); background: rgba(23,20,15,.45); color: var(--l-ink-dim); text-decoration: none; text-align: left; cursor: pointer; transition: background .2s,color .2s,padding .2s; }
  .entity__doors a:hover, .entity__doors button:hover { padding-left: 1rem; color: var(--l-ink); background: rgba(43,36,25,.78); }
  .entity__doors span, .entity__doors em { font: .5rem var(--l-font-mono); font-style: normal; color: var(--l-ink-faint); }
  .entity__doors strong { font: 300 .86rem var(--l-font-body); }
  .entity__doors i { color: var(--l-accent); font-style: normal; }

  .entity__story { position: absolute; z-index: 4; left: 6vw; bottom: 7vh; width: min(25rem,32vw); display: grid; grid-template-columns: 1fr auto; padding: 1rem 1.2rem; border: 1px solid var(--l-accent-dim); background: rgba(32,27,20,.8); color: var(--l-ink); text-decoration: none; }
  .entity__story span { grid-column: 1; color: var(--l-accent); font: .5rem var(--l-font-mono); letter-spacing: .14em; }
  .entity__story strong { grid-column: 1; margin-top: .35rem; font: 300 1rem var(--l-font-body); }
  .entity__story i { grid-column: 2; grid-row: 1 / 3; align-self: center; color: var(--l-accent); font-style: normal; }

  @media (max-width: 820px) {
    .entity { overflow-y: auto; padding: 5.5rem 1rem 3rem; }
    .entity__field { position: absolute; left: 0; height: 24rem; bottom: auto; }
    .entity__header, .entity__doors, .entity__story { position: relative; left: auto; right: auto; top: auto; bottom: auto; width: 100%; }
    .entity__header { margin-top: 4rem; padding: 1rem; background: rgba(23,20,15,.8); }
    .entity__header h1 { font-size: 2.7rem; }
    .entity__doors { margin-top: 2rem; }
    .entity__story { margin-top: 2rem; }
  }
</style>
